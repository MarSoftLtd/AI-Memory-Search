<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultCard"
    android:layout_width="@dimen/component_result_card_width"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/component_result_card_margin"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_surface_secondary"
    app:cardCornerRadius="@dimen/component_feature_card_radius"
    app:cardElevation="@dimen/elevation_none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/resultNormalContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/component_card_padding"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/resultImage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/component_result_image_height"
                android:background="@color/color_surface_secondary"
                android:scaleType="centerCrop" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_0"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/resultTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="3"
                        android:paddingStart="@dimen/component_card_padding"
                        android:paddingTop="@dimen/spacing_8"
                        android:paddingEnd="@dimen/component_card_padding"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/resultPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="4"
                        android:paddingStart="@dimen/component_card_padding"
                        android:paddingTop="@dimen/spacing_8"
                        android:paddingEnd="@dimen/component_card_padding"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_label" />

                    <LinearLayout
                        android:id="@+id/snippetContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/component_card_padding"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/component_card_padding"
                        android:paddingTop="@dimen/component_label_gap"
                        android:paddingEnd="@dimen/component_card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/result_explanation_label"
                            android:textColor="@color/color_accent_secondary"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/resultSnippet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/component_small_gap"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/resultTechnicalScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clickable="true"
            android:padding="@dimen/component_card_padding"
            android:scrollbars="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/resultTechnicalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/spacing_32"
                android:textColor="@color/color_text_soft"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_caption" />
        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/resultSourceLabel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/component_icon_button_size"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/component_card_padding"
            android:layout_marginTop="@dimen/spacing_8"
            android:layout_marginEnd="@dimen/component_icon_button_size"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textSize="@dimen/text_overline"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/resultTechnicalToggle"
            android:layout_width="@dimen/component_icon_button_size"
            android:layout_height="@dimen/component_icon_button_size"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/spacing_8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/technical_report_toggle"
            android:padding="@dimen/spacing_8"
            android:rotation="90"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/color_text_primary" />

        <View
            android:id="@+id/resultSourceAccent"
            android:layout_width="@dimen/spacing_4"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/color_source_document"
            android:elevation="@dimen/elevation_card" />
    </FrameLayout>
</androidx.cardview.widget.CardView>
