<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultCard"
    android:layout_width="@dimen/component_result_card_width"
    android:layout_height="@dimen/component_result_card_height"
    android:layout_margin="@dimen/spacing_16"
    app:cardCornerRadius="@dimen/component_feature_card_radius"
    app:cardElevation="@dimen/elevation_none"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_surface_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/component_card_padding"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/resultImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/component_result_image_height"
            android:scaleType="centerCrop"/>

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/component_card_padding"
            android:paddingEnd="@dimen/component_card_padding"
            android:paddingTop="@dimen/component_card_padding"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/resultPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/component_card_padding"
            android:paddingEnd="@dimen/component_card_padding"
            android:paddingTop="@dimen/spacing_8"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_label"
            android:maxLines="2"/>

        <LinearLayout
            android:id="@+id/snippetContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/component_card_padding"
            android:paddingStart="@dimen/component_card_padding"
            android:paddingEnd="@dimen/component_card_padding"
            android:paddingTop="@dimen/component_label_gap">

            <TextView
                android:id="@+id/resultSnippetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_explanation_label"
                android:textColor="@color/color_accent_secondary"
                android:textStyle="bold"
                android:textSize="@dimen/text_caption"/>

            <TextView
                android:id="@+id/resultSnippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/component_small_gap"
                android:maxLines="4"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
