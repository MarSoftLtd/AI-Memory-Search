<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="0"
    android:visibility="visible"
    app:cardBackgroundColor="@color/color_surface_modal"
    app:cardCornerRadius="@dimen/dashboard_card_radius"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@android:color/white"
    app:strokeWidth="@dimen/border_width"
    tools:alpha="1"
    tools:visibility="visible">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Fundal glossy, identic cu dialogul existent -->

        <!-- Reflexie discretă în partea de sus -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dashboard_card_padding">

            <!-- Tipul modulului -->

            <TextView
                android:id="@+id/aiPackageTypeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:textColor="@color/color_text_overline"
                android:textSize="@dimen/text_overline"
                android:textStyle="bold"
                tools:text="TRANSLATION PACKAGE" />

            <!-- Titlul pachetului -->

            <TextView
                android:id="@+id/aiPackageTitleText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/component_dialog_title_height"
                android:layout_marginTop="@dimen/spacing_12"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                tools:text="Germanic Translation" />

            <!-- Descriere -->

            <TextView
                android:id="@+id/aiPackageDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/component_dialog_description_height"
                android:layout_marginTop="@dimen/spacing_8"
                android:ellipsize="end"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/spacing_4"
                android:maxLines="3"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_body"
                tools:text="Permite căutarea în limbile germanice și traducerea complet offline în limba engleză." />

            <!-- Starea curentă -->

            <TextView
                android:id="@+id/aiPackageStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_12"
                android:background="@drawable/bg_glossy_icon_button"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="@dimen/spacing_48"
                android:paddingStart="@dimen/spacing_16"
                android:paddingTop="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_16"
                android:paddingBottom="@dimen/spacing_8"
                android:textColor="@color/color_accent_soft"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                tools:text="READY TO DOWNLOAD" />

            <!-- Separator -->

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/border_width"
                android:layout_marginTop="@dimen/spacing_24"
                android:background="@color/color_border_subtle" />

            <!-- Informații pachet -->

            <LinearLayout
                android:id="@+id/aiPackageInfoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:orientation="vertical">

                <!-- Languages -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_package_languages_label"
                        android:textColor="@color/color_text_muted"
                        android:textSize="@dimen/text_caption"
                        tools:text="Languages" />

                    <TextView
                        android:id="@+id/aiPackageLanguagesText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:minLines="2"
                        android:maxLines="2"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="German, Dutch, Swedish, Danish" />

                </LinearLayout>

                <!-- Version -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_package_version_label"
                        android:textColor="@color/color_text_muted"
                        android:textSize="@dimen/text_caption"
                        tools:text="Version" />

                    <TextView
                        android:id="@+id/aiPackageVersionText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="1.0.0" />

                </LinearLayout>

                <!-- Download size -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_package_download_size_label"
                        android:textColor="@color/color_text_muted"
                        android:textSize="@dimen/text_caption"
                        tools:text="Download size" />

                    <TextView
                        android:id="@+id/aiPackageDownloadSizeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="64.1 MB" />

                </LinearLayout>

                <!-- Installed size -->

                <LinearLayout
                    android:id="@+id/aiPackageInstalledSizeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_package_installed_size_label"
                        android:textColor="@color/color_text_muted"
                        android:textSize="@dimen/text_caption"
                        tools:text="Installed size" />

                    <TextView
                        android:id="@+id/aiPackageInstalledSizeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="82.4 MB" />

                </LinearLayout>

            </LinearLayout>

            <!-- Zona de progres.
                 Rămâne în același card pentru:
                 DOWNLOADING / VERIFYING / INSTALLING -->

            <LinearLayout
                android:id="@+id/aiPackageProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/border_width"
                    android:background="@color/color_border_subtle" />

                <TextView
                    android:id="@+id/aiPackageProgressStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/color_text_soft"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    tools:text="Downloading language resources..." />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/aiPackageProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="@color/color_accent"
                    app:trackColor="@color/color_progress_track"
                    app:trackThickness="@dimen/component_progress_height"
                    tools:progress="48" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/aiPackageProgressBytesText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/color_text_muted"
                        android:textSize="@dimen/text_overline"
                        tools:text="30.8 MB / 64.1 MB" />

                    <TextView
                        android:id="@+id/aiPackageProgressPercentText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_accent_soft"
                        android:textSize="@dimen/text_overline"
                        android:textStyle="bold"
                        tools:text="48%" />

                </LinearLayout>

            </LinearLayout>

            <!-- Mesaj de eroare.
                 Java îl afișează numai pentru starea ERROR -->

            <TextView
                android:id="@+id/aiPackageErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/spacing_4"
                android:maxLines="3"
                android:textColor="@color/color_accent_soft"
                android:textSize="@dimen/text_caption"
                android:visibility="gone"
                tools:text="Download failed. Check your connection and try again."
                tools:visibility="visible" />

            <!-- Acțiune principală -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aiPackagePrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/component_button_height"
                android:layout_marginTop="@dimen/spacing_24"
                android:textAllCaps="false"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                app:backgroundTint="@color/color_accent_blue"
                app:cornerRadius="@dimen/dashboard_button_radius"
                app:rippleColor="@color/color_surface_overlay"
                tools:text="Download" />

            <!-- Acțiune secundară -->

            <TextView
                android:id="@+id/aiPackageSecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_12"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/spacing_48"
                android:paddingStart="@dimen/spacing_24"
                android:paddingEnd="@dimen/spacing_24"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                tools:text="Later" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
