<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/component_action_padding"
    app:cardCornerRadius="@dimen/component_list_item_radius"
    app:cardBackgroundColor="@color/color_surface"
    app:cardElevation="@dimen/elevation_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/component_card_padding">

        <ImageView
            android:id="@+id/fileIcon"
            android:layout_width="@dimen/component_file_icon_size"
            android:layout_height="@dimen/component_file_icon_size"
            android:src="@drawable/ic_image"/>

        <LinearLayout
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_16">

            <TextView
                android:id="@+id/fileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_file_name"
                android:textColor="@color/color_text_primary"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"/>

            <TextView
                android:id="@+id/filePath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_file_path"
                android:textColor="@color/color_text_muted"
                android:textSize="@dimen/text_caption"
                android:layout_marginTop="@dimen/component_label_gap"/>

            <TextView
                android:id="@+id/fileType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_file_type"
                android:textColor="@color/color_accent_blue_soft"
                android:textStyle="bold"
                android:textSize="@dimen/text_label"
                android:layout_marginTop="@dimen/component_field_gap"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
