<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050816">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Memory Search"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="50dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search anything on your phone"
        android:textColor="#8E9AB8"
        android:textSize="16sp"
        android:layout_marginTop="3dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="10dp"
        android:elevation="0dp"
        android:translationZ="0dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <!-- GLOSS BACKGROUND -->

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glossy_search"/>

        <!-- TOP SHINE -->

        <View
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_gravity="top"
            android:alpha="0.45"
            android:background="@drawable/bg_glossy_top_shine"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToOutline="true">

            <EditText
                android:id="@+id/searchEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="12dp"
                android:background="@android:color/transparent"
                android:hint="Search ... "
                android:textColor="#FFFFFF"
                android:textColorHint="#93A7D1"
                android:textSize="16sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/clearSearch"/>

            <ImageView
                android:id="@+id/searchButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_glossy_search_button"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#FFFFFF"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageView
                android:id="@+id/clearSearch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:padding="13dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@drawable/bg_glossy_icon_button"
                app:tint="#E2EEFF"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        
        
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/indexStatsCard"
        android:layout_width="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_height="330dp"
        android:elevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        android:layout_marginTop="18dp"
        app:strokeColor="#35FFFFFF"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- GLOSS BACKGROUND -->

            <View
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glossy_index_card" />

            <!-- TOP SHINE -->

            <View
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_gravity="top"
                android:alpha="0.55"
                android:background="@drawable/bg_glossy_top_shine" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:layout_marginTop="5dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.18"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="AI MEMORY ENGINE RESULTS"
        android:textColor="#99FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
    
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingTop="18dp"
                android:paddingEnd="22dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="70dp"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/indexedCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity=""
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Indexed files"
                            android:textAlignment="center"
                            android:textColor="#80FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <com.github.ybq.android.spinkit.SpinKitView
                        android:id="@+id/indexLoader"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="20dp"
                        android:layout_margin="15dp"
                        app:SpinKit_Color="#63E6FF"
                        app:SpinKit_Style="ThreeBounce"
                        android:visibility="gone"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical">

                        <!-- PDF -->

                        <TextView
                            android:id="@+id/pdfCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DOCUMENTS 0"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pdfGauge"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="2dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="#22304F"
                            android:progressTint="#63E6FF" />

                        <!-- JPG -->

                        <TextView
                            android:id="@+id/jpgCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="IMAGES 0"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/jpgGauge"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="2dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="#22304F"
                            android:progressTint="#8B7CFF" />

                        <!-- OCR -->

                        <TextView
                            android:id="@+id/ocrCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="TEXT DETECTED 0"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/ocrGauge"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="2dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="#22304F"
                            android:progressTint="#00F5A0" />

                        <!-- EMBEDDINGS -->

                        <TextView
                            android:id="@+id/embeddingCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="AI INDEXED 0"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/embeddingGauge"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="2dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="#22304F"
                            android:progressTint="#00D4FF" />
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/speedText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="SPEED 0/s"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/etaText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|bottom"
                            android:layout_marginTop="6dp"
                            android:text="ETA --"
                            android:textColor="#7FDBFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
        </FrameLayout>
                        
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_gravity="bottom"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:orientation="vertical"
                android:layout_height="70dp">
                <TextView
                    android:id="@+id/stageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="STAGE - Idle"
                    android:textColor="#AFC6F9"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                
                <TextView
                    android:id="@+id/liveIndexingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Idle"
                    android:textColor="#00D4FF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/searchInvitePanel"
        android:layout_width="390dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:minHeight="180dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.476"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/indexStatsCard"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/titleText_unu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search your phone memory"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:fadeScrollbars="false"
            android:scrollbars="none">

            <TextView
                android:id="@+id/subtitleText_unu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:justificationMode="inter_word"
                android:lineSpacingExtra="4dp"
                android:paddingBottom="16dp"
                android:text="Type something like invoice, screenshot, name, document, location or text from an image."
                android:textColor="#8E9AB8"
                android:textSize="12sp" />

        </ScrollView>
    </LinearLayout>
    <View
        android:id="@+id/dimView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:alpha="0"
        android:visibility="gone" />
    
    <androidx.cardview.widget.CardView
        android:id="@+id/permissionCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="40dp"
        android:translationZ="40dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="#F0121B32"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Local AI Search"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="AI Memory Search needs storage access to index your screenshots, images and PDFs directly on your phone. Everything stays offline. No cloud. No external API."
                android:textColor="#AFC0E8"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"/>

            <Button
                android:id="@+id/btnGrantAccess"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Grant Access"
                android:textAllCaps="false"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
    
    <androidx.cardview.widget.CardView
        android:id="@+id/exitCard"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="40dp"
        android:translationZ="40dp"
        android:background="@drawable/bg_glossy_ai_card"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exit AI Memory Search?"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Are you sure you want to close the application?"
                android:textColor="#C7D7F5"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnNoExit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No"
                    android:textColor="#AFC6F9"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="14dp"/>

                <TextView
                    android:id="@+id/btnYesExit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="Yes"
                    android:textColor="#7FDBFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="14dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>