<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_title"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_screen_title"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/component_screen_top_margin"
        android:layout_marginStart="@dimen/spacing_24"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_subtitle"
        android:textColor="@color/color_text_muted"
        android:textSize="@dimen/text_body"
        android:layout_marginTop="@dimen/component_tiny_gap"
        android:layout_marginStart="@dimen/spacing_24"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/component_search_height"
        android:layout_marginStart="@dimen/spacing_24"
        android:layout_marginEnd="@dimen/spacing_24"
        android:layout_marginTop="@dimen/component_field_gap"
        android:elevation="@dimen/elevation_none"
        android:translationZ="@dimen/elevation_none"
        app:cardCornerRadius="@dimen/radius_large"
        app:cardElevation="@dimen/elevation_none"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <!-- GLOSS BACKGROUND -->

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glossy_search"/>

        <!-- TOP SHINE -->

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/component_search_highlight_height"
            android:layout_gravity="top"
            android:alpha="0.45"
            android:background="@drawable/bg_glossy_top_shine"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToOutline="true">

            <EditText
                android:id="@+id/searchEdit"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/component_search_text_inset"
                android:layout_marginEnd="@dimen/spacing_12"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_hint"
                android:textSize="@dimen/text_body"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/clearSearch"/>

            <ImageView
                android:id="@+id/searchButton"
                android:layout_width="@dimen/component_icon_button_size"
                android:layout_height="@dimen/component_icon_button_size"
                android:layout_marginEnd="@dimen/spacing_12"
                android:background="@drawable/bg_glossy_search_button"
                android:padding="@dimen/spacing_12"
                android:src="@drawable/ic_search"
                app:tint="@color/color_text_primary"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageView
                android:id="@+id/clearSearch"
                android:layout_width="@dimen/component_icon_button_size"
                android:layout_height="@dimen/component_icon_button_size"
                android:layout_marginEnd="@dimen/spacing_12"
                android:padding="@dimen/spacing_12"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_glossy_icon_button"
                app:tint="@color/color_text_primary"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        
        
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/indexStatsCard"
        android:layout_width="@dimen/spacing_0"
        android:layout_marginStart="@dimen/spacing_24"
        android:layout_marginEnd="@dimen/spacing_24"
        android:layout_height="@dimen/component_stats_height"
        android:elevation="@dimen/elevation_none"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/radius_large"
        app:cardElevation="@dimen/elevation_none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        android:layout_marginTop="@dimen/component_card_padding"
        app:strokeColor="@color/color_border"
        app:strokeWidth="@dimen/border_width">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- GLOSS BACKGROUND -->

            <View
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glossy_index_card" />

            <!-- TOP SHINE -->

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/component_card_highlight_height"
                android:layout_gravity="top"
                android:alpha="0.55"
                android:background="@drawable/bg_glossy_top_shine" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="@dimen/spacing_48"
    android:layout_marginTop="@dimen/component_compact_gap">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.18"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/engine_results_header"
        android:textColor="@color/color_text_overline"
        android:textSize="@dimen/text_overline"
        android:textStyle="bold" />
</LinearLayout>
    
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/component_stats_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/component_card_padding"
                android:paddingTop="@dimen/component_card_padding"
                android:paddingEnd="@dimen/component_search_text_inset"
                android:paddingBottom="@dimen/component_card_padding">

                <LinearLayout
                    android:layout_width="@dimen/component_stats_column_width"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="@dimen/component_stats_column_top_margin"
                    android:layout_marginStart="@dimen/component_field_gap"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/indexedCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity=""
                            android:text="0"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_display"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/indexed_files_label"
                            android:textAlignment="center"
                            android:textColor="@color/color_overlay_highlight"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                    <com.github.ybq.android.spinkit.SpinKitView
                        android:id="@+id/indexLoader"
                        android:layout_width="@dimen/component_loader_size"
                        android:layout_height="@dimen/component_loader_size"
                        android:layout_marginTop="@dimen/component_loader_margin"
                        android:layout_margin="@dimen/component_card_padding"
                        app:SpinKit_Color="@color/color_accent_secondary"
                        app:SpinKit_Style="ThreeBounce"
                        android:visibility="gone"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_0"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical">

                        <!-- PDF -->

                        <TextView
                            android:id="@+id/pdfCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/documents_count_initial"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_overline"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pdfGauge"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/component_progress_height"
                            android:layout_marginTop="@dimen/component_small_gap"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="@color/color_progress_track"
                            android:progressTint="@color/color_accent_secondary" />

                        <!-- JPG -->

                        <TextView
                            android:id="@+id/jpgCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_8"
                            android:text="@string/images_count_initial"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_overline"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/jpgGauge"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/component_progress_height"
                            android:layout_marginTop="@dimen/component_small_gap"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="@color/color_progress_track"
                            android:progressTint="@color/color_accent_violet" />

                        <!-- OCR -->

                        <TextView
                            android:id="@+id/ocrCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_8"
                            android:text="@string/text_detected_count_initial"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_overline"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/ocrGauge"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/component_progress_height"
                            android:layout_marginTop="@dimen/component_small_gap"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="@color/color_progress_track"
                            android:progressTint="@color/color_success" />

                        <!-- EMBEDDINGS -->

                        <TextView
                            android:id="@+id/embeddingCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_8"
                            android:text="@string/ai_indexed_count_initial"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_overline"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/embeddingGauge"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/component_progress_height"
                            android:layout_marginTop="@dimen/component_small_gap"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="@color/color_progress_track"
                            android:progressTint="@color/color_accent" />
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/speedText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/component_field_gap"
                            android:text="@string/speed_initial"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_overline"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/etaText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|bottom"
                            android:layout_marginTop="@dimen/component_label_gap"
                            android:text="@string/eta_initial"
                            android:textColor="@color/color_accent_soft"
                            android:textSize="@dimen/text_overline"
                            android:textStyle="bold" />
        </FrameLayout>
                        
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/component_card_padding"
                android:layout_marginEnd="@dimen/component_card_padding"
                android:orientation="vertical"
                android:layout_height="@dimen/component_card_highlight_height">
                <TextView
                    android:id="@+id/stageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/stage_idle"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_overline"
                    android:textStyle="bold" />
                
                <TextView
                    android:id="@+id/liveIndexingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/component_compact_gap"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/idle"
                    android:textColor="@color/color_accent"
                    android:textSize="@dimen/text_overline"
                    android:textStyle="bold"/>
            </LinearLayout>
        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/searchInvitePanel"
        android:layout_width="@dimen/component_invite_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/component_invite_padding"
        android:minHeight="@dimen/component_invite_min_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.476"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/indexStatsCard"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/titleText_unu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_invite_title"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/spacing_12"
            android:fadeScrollbars="false"
            android:scrollbars="none">

            <TextView
                android:id="@+id/subtitleText_unu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:justificationMode="inter_word"
                android:lineSpacingExtra="@dimen/spacing_4"
                android:paddingBottom="@dimen/spacing_16"
                android:text="@string/search_invite_body"
                android:textColor="@color/color_text_muted"
                android:textSize="@dimen/text_caption" />

        </ScrollView>
    </LinearLayout>
    <View
        android:id="@+id/dimView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_overlay"
        android:alpha="0"
        android:visibility="gone" />
    
    <androidx.cardview.widget.CardView
        android:id="@+id/permissionCard"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/component_modal_horizontal_margin"
        android:layout_marginEnd="@dimen/component_modal_horizontal_margin"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="@dimen/elevation_overlay"
        android:translationZ="@dimen/elevation_overlay"
        app:cardCornerRadius="@dimen/radius_extra_large"
        app:cardElevation="@dimen/elevation_modal"
        app:cardBackgroundColor="@color/color_surface_modal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/component_dialog_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permission_title"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/component_action_padding"
                android:text="@string/permission_body"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_body"
                android:lineSpacingExtra="@dimen/spacing_4"/>

            <Button
                android:id="@+id/btnGrantAccess"
                android:layout_width="match_parent"
                android:layout_height="@dimen/component_button_height"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/grant_access"
                android:textAllCaps="false"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
    
    <androidx.cardview.widget.CardView
        android:id="@+id/exitCard"
        android:layout_width="@dimen/component_dialog_width"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="@dimen/elevation_overlay"
        android:translationZ="@dimen/elevation_overlay"
        android:background="@drawable/bg_glossy_ai_card"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/radius_extra_large"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/component_dialog_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exit_title"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/component_action_padding"
                android:text="@string/exit_body"
                android:textColor="@color/color_text_soft"
                android:textSize="@dimen/text_body"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/component_dialog_actions_margin"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnNoExit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:padding="@dimen/component_action_padding"/>

                <TextView
                    android:id="@+id/btnYesExit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/component_card_padding"
                    android:text="@string/yes"
                    android:textColor="@color/color_accent_soft"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:padding="@dimen/component_action_padding"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
    <include
        android:id="@+id/aiPackageCard"
        layout="@layout/dialog_ai_package"
        android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>
