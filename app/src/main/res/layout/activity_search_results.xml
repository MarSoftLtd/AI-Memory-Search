<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <View
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/spacing_0"
        android:background="@color/color_background_scrim"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/backgroundBlur"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/spacing_0"
        android:scaleType="centerCrop"
        android:alpha="0.22"
        android:scaleX="1.15"
        android:scaleY="1.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    
    <TextView
        android:id="@+id/resultsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/results_title"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_screen_title"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/component_results_top_margin"
        android:layout_marginStart="@dimen/component_results_title_inset"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/resultsCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/text_body"
        android:layout_marginTop="@dimen/component_field_gap"
        android:layout_marginStart="@dimen/component_results_title_inset"
        app:layout_constraintTop_toBottomOf="@id/resultsTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultsRecycler"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/spacing_0"
        android:clipToPadding="false"
        android:paddingStart="@dimen/component_results_recycler_padding"
        android:paddingEnd="@dimen/component_results_recycler_padding"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/resultsCount"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
