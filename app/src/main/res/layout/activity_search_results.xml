<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/searchResultsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <ImageView
        android:id="@+id/backgroundBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:scaleType="centerCrop"
        android:scaleX="1.15"
        android:scaleY="1.15" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_background_scrim" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="@dimen/component_results_top_margin"
            android:paddingBottom="@dimen/spacing_0">

            <TextView
                android:id="@+id/resultsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/component_results_title_inset"
                android:text="@string/results_title"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_screen_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/component_results_title_inset"
                android:layout_marginTop="@dimen/component_field_gap"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_body" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_0"
                android:layout_weight="1"
                android:layout_marginBottom="30dp"
                android:layout_marginTop="35dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/resultsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="never" />

                <ImageButton
                    android:id="@+id/resultPrevious"
                    android:layout_width="@dimen/component_icon_button_size"
                    android:layout_height="@dimen/component_icon_button_size"
                    android:layout_gravity="start|bottom"
                    android:layout_marginBottom="80dp"
                    android:alpha="0.82"
                    android:background="@drawable/bg_technical_report_toggle"
                    android:contentDescription="@string/result_previous"
                    android:padding="@dimen/spacing_8"
                    android:rotation="180"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/color_text_primary" />

                <ImageButton
                    android:id="@+id/resultNext"
                    android:layout_width="@dimen/component_icon_button_size"
                    android:layout_height="@dimen/component_icon_button_size"
                    android:layout_gravity="end|bottom"
                    android:layout_marginBottom="80dp"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:alpha="0.82"
                    android:background="@drawable/bg_technical_report_toggle"
                    android:contentDescription="@string/result_next"
                    android:padding="@dimen/spacing_8"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/color_text_primary" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
