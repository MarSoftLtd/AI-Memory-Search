<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>

        <shape android:shape="rectangle">

            <corners android:radius="32dp"/>

            <gradient
                android:angle="270"
                android:startColor="#FF425D91"
                android:centerColor="#FF283B61"
                android:endColor="#FF182338"/>

            <stroke
                android:width="1.4dp"
                android:color="#CCFFFFFF"/>

        </shape>

    </item>

    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">

        <shape android:shape="rectangle">

            <corners android:radius="31dp"/>

            <gradient
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"/>

        </shape>

    </item>

</layer-list>