<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>

        <shape android:shape="rectangle">

            <corners android:radius="@dimen/radius_large"/>

            <gradient
                android:angle="270"
                android:startColor="@color/color_search_panel_top"
                android:centerColor="@color/color_search_panel_middle"
                android:endColor="@color/color_modal_surface_bottom"/>

            <stroke
                android:width="@dimen/border_width"
                android:color="@color/color_border_strong"/>

        </shape>

    </item>

    <item
        android:left="@dimen/border_width"
        android:right="@dimen/border_width"
        android:top="@dimen/border_width">

        <shape android:shape="rectangle">

            <corners android:radius="@dimen/radius_large"/>

            <gradient
                android:angle="270"
                android:startColor="@color/color_surface_overlay"
                android:endColor="@color/color_none"/>

        </shape>

    </item>

</layer-list>
